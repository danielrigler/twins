TwinGrain : MultiOutUGen {
	*ar { arg trigger = 0, dur = 1, bufL = 0, bufR = 0, rateL = 1, rateR = 1, posL = 0, posR = 0, panL = 0, panR = 0, envbufnum = -1, delayBlocks = 0, maxGrains = 80, shareTol = 0, mul = 1, add = 0;
		^this.multiNew('audio', trigger, dur, bufL, bufR, rateL, rateR, posL, posR, panL, panR, envbufnum, delayBlocks, maxGrains, shareTol).madd(mul, add)
	}
	init { arg ... theInputs; inputs = theInputs; ^this.initOutputs(2, rate) }
	argNamesInputsOffset { ^1 }
}
